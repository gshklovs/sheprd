[Unit]
Description=sheprd: herdr agents on your phone
# Reference unit for packagers; `sheprd setup` writes its own (with your PATH) to ~/.config/systemd/user.
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/sheprd serve
Restart=always
RestartSec=2
Nice=5
# Small and quiet: cap memory so a runaway can never hurt the desktop.
MemoryMax=200M
Environment=RUST_BACKTRACE=0

[Install]
WantedBy=default.target
